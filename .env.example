# Road Weather Dashboard - Environment Configuration
# Copy to .env.local for local development. Never commit real values.
#
# All variables here are SERVER-SIDE ONLY. Do not prefix any of them with
# NEXT_PUBLIC_: that would inline the value into the client bundle where
# anyone can read it.

# Base URL of the FastAPI backend on Render, with no trailing /api.
# Local development: http://localhost:8000
BACKEND_URL=https://road-weather-api.onrender.com

# Shared secret for the backend. Must match API_KEY in the Render service.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# JWT signing secret for dashboard sessions. Required - there is no fallback.
# Generate: openssl rand -base64 48
JWT_SECRET=
